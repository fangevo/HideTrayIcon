<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ COLOR PALETTE ═══ -->
    <Color x:Key="WindowBg">#FFF5F5F7</Color>
    <Color x:Key="SidebarBg">#FFFFFFFF</Color>
    <Color x:Key="CardBg">#FFFFFFFF</Color>
    <Color x:Key="SubtleBg">#FFECEFF4</Color>
    <Color x:Key="HoverBg">#FFE2E6ED</Color>
    <Color x:Key="AccentColor">#FF6C63FF</Color>
    <Color x:Key="AccentHover">#FF5B52E0</Color>
    <Color x:Key="PrimaryText">#FF1A1A2E</Color>
    <Color x:Key="SecondaryText">#FF6B7280</Color>
    <Color x:Key="BorderColor">#FFE0E0E0</Color>
    <Color x:Key="DangerColor">#FFE53935</Color>
    <Color x:Key="SuccessColor">#FF43A047</Color>

    <!-- ═══ BRUSHES ═══ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBg}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBg}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBg}" />
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleBg}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverBg}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

</ResourceDictionary>
