<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ COLOR PALETTE ═══ -->
    <Color x:Key="WindowBg">#FF1A1A2E</Color>
    <Color x:Key="SidebarBg">#FF16213E</Color>
    <Color x:Key="CardBg">#FF1F2940</Color>
    <Color x:Key="SubtleBg">#FF2A3550</Color>
    <Color x:Key="HoverBg">#FF2D3A56</Color>
    <Color x:Key="AccentColor">#FF6C63FF</Color>
    <Color x:Key="AccentHover">#FF8B83FF</Color>
    <Color x:Key="PrimaryText">#FFFAFAFA</Color>
    <Color x:Key="SecondaryText">#FFB0B8C8</Color>
    <Color x:Key="BorderColor">#FF2A3550</Color>
    <Color x:Key="DangerColor">#FFFF5252</Color>
    <Color x:Key="SuccessColor">#FF4CAF50</Color>

    <!-- ═══ BRUSHES ═══ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBg}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBg}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBg}" />
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleBg}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverBg}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

</ResourceDictionary>
