<UserControl x:Class="TrayZen.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,24" />

            <!-- ── APPEARANCE ── -->
            <TextBlock Text="APPEARANCE" Style="{DynamicResource SectionHeaderStyle}" />

            <Border Style="{DynamicResource SettingsRowStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dark Mode" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Use dark color scheme" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding UseDarkMode}"
                                  Style="{DynamicResource ToggleSwitchStyle}"
                                  HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- ── BEHAVIOR ── -->
            <TextBlock Text="BEHAVIOR" Style="{DynamicResource SectionHeaderStyle}" Margin="0,20,0,12" />

            <Border Style="{DynamicResource SettingsRowStyle}" Margin="0,0,0,4">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Launch TrayZen at login" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding StartWithWindows}"
                                  Style="{DynamicResource ToggleSwitchStyle}"
                                  HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Border Style="{DynamicResource SettingsRowStyle}" Margin="0,0,0,4">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start Minimized" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Hide window on startup" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding StartMinimized}"
                                  Style="{DynamicResource ToggleSwitchStyle}"
                                  HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Border Style="{DynamicResource SettingsRowStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Minimize to Tray" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Close button hides to system tray" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding MinimizeToTray}"
                                  Style="{DynamicResource ToggleSwitchStyle}"
                                  HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- ── PERFORMANCE ── -->
            <TextBlock Text="PERFORMANCE" Style="{DynamicResource SectionHeaderStyle}" Margin="0,20,0,12" />

            <Border Style="{DynamicResource SettingsRowStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Refresh Interval" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="Poll every" />
                            <Run Text="{Binding RefreshInterval, Mode=OneWay}" />
                            <Run Text="ms" />
                        </TextBlock>
                    </StackPanel>
                    <Slider Value="{Binding RefreshInterval}" Minimum="1000" Maximum="10000"
                            TickFrequency="1000" IsSnapToTickEnabled="True"
                            Width="180" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{DynamicResource SliderStyle}" />
                </Grid>
            </Border>

            <!-- ── HOTKEY ── -->
            <TextBlock Text="HOTKEY" Style="{DynamicResource SectionHeaderStyle}" Margin="0,20,0,12" />

            <Border Style="{DynamicResource SettingsRowStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Zen Mode Hotkey" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Toggle Zen Mode globally" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border x:Name="HotkeyDisplay" CornerRadius="6" Padding="12,6"
                                Background="{DynamicResource SubtleBrush}"
                                Focusable="True" Cursor="Hand"
                                MouseLeftButtonDown="HotkeyDisplay_Click"
                                PreviewKeyDown="HotkeyDisplay_KeyDown">
                            <TextBlock FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding HotkeyDisplay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                <Setter Property="Text" Value="Press keys..." />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── AUTO-HIDE RULES ── -->
            <TextBlock Text="SMART AUTO-HIDE" Style="{DynamicResource SectionHeaderStyle}" Margin="0,20,0,12" />

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,8">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding NewAutoHideProcess, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource SearchTextBoxStyle}"
                             Tag="Process name (e.g. Slack)" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="Idle (sec)" FontSize="10" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding NewAutoHideSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource SearchTextBoxStyle}"
                                 Width="60" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Add Rule"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding AddAutoHideRuleCommand}" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding AutoHideRules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource SettingsRowStyle}" Margin="0,0,0,4">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding ProcessName}" />
                                    <TextBlock FontSize="11" Opacity="0.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="Hide after" />
                                        <Run Text="{Binding IdleThresholdSeconds, Mode=OneWay}" />
                                        <Run Text="seconds idle" />
                                    </TextBlock>
                                </StackPanel>

                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                        Style="{DynamicResource IconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.RemoveAutoHideRuleCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="Remove" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Save button -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Save Settings" Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}" Padding="24,10" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
