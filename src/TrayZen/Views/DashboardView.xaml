<UserControl x:Class="TrayZen.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TrayZen.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER + STATS ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />

            <UniformGrid Columns="3">
                <Border Style="{DynamicResource StatCardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Total Icons" FontSize="12" Opacity="0.6"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource StatCardStyle}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="{Binding VisibleCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="#4CAF50" />
                        <TextBlock Text="Visible" FontSize="12" Opacity="0.6"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource StatCardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding HiddenCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="#FF5722" />
                        <TextBlock Text="Hidden" FontSize="12" Opacity="0.6"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ SEARCH BAR ═══ -->
        <Border Grid.Row="1" Style="{DynamicResource SearchBarStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="14,0,8,0" />

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource SearchTextBoxStyle}"
                         Tag="Search tray icons..." />

                <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                        Style="{DynamicResource IconButtonStyle}"
                        Command="{Binding RefreshIconsCommand}" ToolTip="Refresh" Margin="0,0,6,0" />
            </Grid>
        </Border>

        <!-- ═══ ICON LIST ═══ -->
        <ListView Grid.Row="2" ItemsSource="{Binding Icons}"
                  Style="{DynamicResource IconListStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TrayIconInfo}">
                    <Border Style="{DynamicResource IconRowStyle}" Margin="0,0,0,4">
                        <Grid Height="60" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon image -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                    Background="{DynamicResource SubtleBrush}" HorizontalAlignment="Center">
                                <Image Source="{Binding IconImageSource}" Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- Process + tooltip -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <!-- Essential badge -->
                                    <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                            Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding IsEssential, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Essential" FontSize="9" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Tooltip}" FontSize="11" Opacity="0.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="280" />
                            </StackPanel>

                            <!-- Mark essential toggle -->
                            <Button Grid.Column="2" ToolTip="Toggle Essential (Zen Mode whitelist)"
                                    Style="{DynamicResource IconButtonStyle}" FontSize="12"
                                    Command="{Binding DataContext.ToggleEssentialCommand,
                                              RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}">
                                <TextBlock FontFamily="Segoe MDL2 Assets">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE734;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEssential}" Value="True">
                                                    <Setter Property="Text" Value="&#xE735;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Replace icon -->
                            <Button Grid.Column="3" Content="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                    Style="{DynamicResource IconButtonStyle}" ToolTip="Replace Icon"
                                    Command="{Binding DataContext.ReplaceIconCommand,
                                              RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}" />

                            <!-- Custom icon indicator -->
                            <TextBlock Grid.Column="4" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="2,0"
                                       ToolTip="{Binding CustomIconPath}"
                                       Visibility="{Binding CustomIconPath, Converter={StaticResource NullToVis}}" />

                            <!-- Visibility toggle -->
                            <ToggleButton Grid.Column="5" IsChecked="{Binding IsVisible, Mode=OneWay}"
                                          Style="{DynamicResource ToggleSwitchStyle}" Margin="4,0,8,0"
                                          Command="{Binding DataContext.ToggleVisibilityCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
