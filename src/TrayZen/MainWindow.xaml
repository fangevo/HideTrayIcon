<Window x:Class="TrayZen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TrayZen.ViewModels"
        xmlns:views="clr-namespace:TrayZen.Views"
        Title="TrayZen" Width="960" Height="640"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ SIDEBAR ═══ -->
            <Border Grid.Column="0" CornerRadius="12,0,0,12"
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drag area -->
                    <Border Grid.Row="0" Height="36" Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                    <!-- Branding -->
                    <StackPanel Grid.Row="1" Margin="24,4,24,24">
                        <TextBlock Text="TrayZen" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="System Tray Manager" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Nav -->
                    <StackPanel Grid.Row="2" Margin="12,0">
                        <RadioButton Style="{DynamicResource NavButtonStyle}" IsChecked="True"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Width="20" />
                                <TextBlock Text="Dashboard" FontFamily="Segoe UI"
                                           FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Profiles">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Width="20" />
                                <TextBlock Text="Profiles" FontFamily="Segoe UI"
                                           FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Width="20" />
                                <TextBlock Text="Settings" FontFamily="Segoe UI"
                                           FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Zen button -->
                    <Button Grid.Row="3" Style="{DynamicResource ZenButtonStyle}"
                            Command="{Binding ToggleZenModeCommand}" Margin="16,0,16,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Zen Mode" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsZenModeActive}" Value="True">
                                                <Setter Property="Text" Value="Exit Zen" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Status bar -->
                    <Border Grid.Row="4" Padding="16,8" Opacity="0.6">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Running as user" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Text" Value="Running as admin" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ CONTENT ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,4,8,0">
                        <Button Style="{DynamicResource CaptionButtonStyle}"
                                Content="&#xE949;" Click="MinimizeButton_Click" />
                        <Button Style="{DynamicResource CaptionButtonStyle}"
                                Content="&#xE739;" Click="MaximizeButton_Click" />
                        <Button Style="{DynamicResource CloseButtonStyle}"
                                Content="&#xE106;" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- View host with fade transition -->
                <Border Grid.Row="1" Margin="24,0,24,24">
                    <ContentPresenter x:Name="ViewHost" Content="{Binding CurrentView}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
